{
  "lexicon": 1,
  "id": "com.hikeratlas.temp.track",
  "description": "A GPX trace of one outing, a day hike or a whole multi-day trip, on Hiker Atlas (https://www.hikeratlas.com). In beta: may change.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "gpx",
          "createdAt"
        ],
        "properties": {
          "gpx": {
            "type": "blob",
            "accept": [
              "application/gpx+xml",
              "application/gzip",
              "application/zstd"
            ],
            "maxSize": 10000000,
            "description": "One GPX file for the whole outing, as is or compressed (the blob's mimeType says which; writers should prefer gzip). A multi-day trip recorded in several files is packaged into one, a <trk> per file, in time order."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "startedAt": {
            "type": "string",
            "format": "datetime"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds, from the first point to the last (for a multi-day trip, including nights)."
          },
          "distance": {
            "type": "integer",
            "minimum": 0,
            "description": "Metres."
          },
          "gain": {
            "type": "integer",
            "minimum": 0,
            "description": "Metres climbed."
          },
          "title": {
            "type": "string",
            "maxGraphemes": 200
          },
          "routeKey": {
            "type": "ref",
            "ref": "com.hikeratlas.temp.defs#routeKey",
            "description": "The curated route they set out to hike, as they chose it. The trace may differ from it (side trips, a different start, turning back)."
          },
          "photos": {
            "type": "array",
            "maxLength": 50,
            "items": {
              "type": "ref",
              "ref": "com.hikeratlas.temp.defs#photo"
            }
          }
        }
      }
    }
  }
}
