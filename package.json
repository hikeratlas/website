{
  "name": "website",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run copy-worker && react-router build && rm -rf public && cp -r build/client public",
    "copy-worker": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs static/",
    "dev": "npm run copy-worker && react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "wrangler pages dev --compatibility-date=2023-06-21 ./public",
    "typecheck": "tsc",
    "pages:deploy": "npm run build && wrangler pages deploy ./public"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@mapbox/vector-tile": "^3.0.0",
    "@react-router/cloudflare": "8.5.1",
    "downshift": "^8.3.1",
    "isbot": "^4.1.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.16.0",
    "pbf": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "remix-utils": "^10.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.72.2",
    "acorn": "^8.15.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "@react-router/cloudflare": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    },
    "typescript": "$typescript"
  }
}
