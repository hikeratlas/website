{
  "name": "website",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run copy-worker && remix build",
    "copy-worker": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/",
    "dev": "npm run copy-worker && remix dev --manual -c \"npm run start\"",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "wrangler pages dev --compatibility-date=2023-06-21 ./public",
    "typecheck": "tsc",
    "pages:deploy": "npm run build && wrangler pages deploy ./public"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@mapbox/vector-tile": "^3.0.0",
    "@remix-run/cloudflare": "^2.4.1",
    "@remix-run/cloudflare-pages": "^2.4.1",
    "@remix-run/css-bundle": "^2.4.1",
    "@remix-run/react": "^2.4.1",
    "downshift": "^8.3.1",
    "isbot": "^4.1.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.16.0",
    "pbf": "^5.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remix-utils": "^7.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@remix-run/dev": "^2.4.1",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.1.0",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@remix-run/cloudflare": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    },
    "@remix-run/cloudflare-pages": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
